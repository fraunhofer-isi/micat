// This is the configuration for renovate bot, referenced from
// github workflow .github/workflows/renovate.yml
// Also see
// https://github.com/renovatebot/github-action
// https://docs.renovatebot.com/self-hosted-configuration/

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":disableDependencyDashboard"],
  forkProcessing: "enabled",
  autodiscoverFilter: ["fraunhofer-isi/micat"],
  packageRules: [
    {
      description: "lockFileMaintenance",
      matchUpdateTypes: [
        "pin",
        "digest",
        "patch",
        "minor",
        "major",
        "lockFileMaintenance",
      ],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      // set to false if you want updates only to be installed if tests pass
      dependencyDashboardApproval: false,
      minimumReleaseAge: null,
    },
    {
      description: "pin pipreqs to 0.4.13",
      matchPackageNames: ["pipreqs"],
      matchDatasources: ["pypi"],
      allowedVersions: "0.4.13",
      rangeStrategy: "replace",
    },
    {
      description: "pin numpy to 2.4.6",
      matchPackageNames: ["numpy"],
      matchDatasources: ["pypi"],
      allowedVersions: "2.4.6",
      rangeStrategy: "replace",
    },
    {
      description: "pin scipy to 1.17.1",
      matchPackageNames: ["scipy"],
      matchDatasources: ["pypi"],
      allowedVersions: "1.17.1",
      rangeStrategy: "replace",
    },
    {
        description: "pin sphinx to 9.0.4 (9.1.0 requires Python 3.12+)",
        matchPackageNames: ["Sphinx"],
        matchDatasources: ["pypi"],
        allowedVersions: "9.0.4",
        rangeStrategy: "replace",
      },
    {
  description: "pin licensecheck to 2025.1.0 (2026.0.0+ requires Python 3.12+)",
  matchPackageNames: ["licensecheck"],
  matchDatasources: ["pypi"],
  allowedVersions: "2025.1.0",
  rangeStrategy: "replace",
}
  ],
}
